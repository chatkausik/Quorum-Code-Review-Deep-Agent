# --- model provider -------------------------------------------------------
# "openai" (default) or "anthropic".
MODEL_PROVIDER=openai

# Needed for the provider you select above.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- GitHub ---------------------------------------------------------------
# Reads the PR and posts the review. Use a classic PAT with the "repo" scope,
# or a fine-grained token with "Pull requests: Read and write" AND the target
# repository listed under Repository access.
# Leave unset to fall back to the GitHub CLI's token (`gh auth login`).
GITHUB_TOKEN=

# --- observability (optional) ---------------------------------------------
# A real key enables tracing and the in-app trace links. Placeholders are
# detected and ignored.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Quorum
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- semantic long-term memory (optional) ---------------------------------
# A real key enables Mem0 automatically. Quorum sends only sanitized aggregate
# outcomes under an opaque repository hash; it never sends source, patches,
# repository names, paths, finding prose, anchors, or PR text to Mem0.
MEM0_API_KEY=
# MEM0_ENABLED=true
# MEM0_APP_ID=quorum-code-review
# MEM0_TOP_K=8
# MEM0_MAX_CONTEXT_CHARS=4000
# MEM0_TIMEOUT_SECONDS=10

# --- optional overrides ---------------------------------------------------
# REVIEW_COST_PROFILE=balanced        # economy | balanced | thorough
# ORCHESTRATOR_MODEL=gpt-5.4          # non-empty provider-compatible model id
# SUBAGENT_MODEL=gpt-5.4-mini
# ORCHESTRATOR_EFFORT=medium           # low | medium | high
# SUBAGENT_EFFORT=low                  # low | medium | high
# REVIEW_MAX_OUTPUT_TOKENS=12000
# REVIEW_MAX_COST_USD=1.00
# REVIEW_MAX_LLM_CALLS=25
# REVIEW_MAX_FILES=50
# REVIEW_MAX_TOTAL_CHARS=1000000
# REVIEW_CONFIDENCE_THRESHOLD=75
# REVIEW_DOCS=false                   # true to also review markdown/docs
# REVIEW_MEMORY_DIR=~/.quorum_memory
# REVIEW_IMPROVEMENT_DB=~/.quorum_memory/improvement.db
# QUORUM_SKILLS_DIR=/path/to/skills    # only for custom/nonstandard installs
